# ---------------------------------------------------------------------------
# LM-SCAN environment configuration template.
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=lmscan
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=lmscan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lmscan:change-me-locally@localhost:5432/lmscan

# --- Auth / security ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ---------------------------------------------------------------
# Local filesystem storage root for uploaded screenshots / downloaded images / reports.
# A relative path here is resolved against the backend package root (apps/backend),
# regardless of the current working directory the app/tests/scripts are run from.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=15

# --- Scraping ---------------------------------------------------------------
SCRAPER_USER_AGENT=LM-SCAN-Inspection-Bot/1.0 (+contact: compliance-tooling@example.gov; automated preliminary inspection tool; respects robots.txt)
SCRAPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=2
SCRAPER_MAX_IMAGES_PER_PRODUCT=8
PLAYWRIGHT_HEADLESS=true

# --- OCR ---------------------------------------------------------------
# OCR_ENGINE=tesseract | paddleocr (paddleocr requires the optional paddleocr extra to be installed)
OCR_ENGINE=tesseract
# Path/command to the tesseract binary. On Linux/Docker "tesseract" (on PATH) is enough.
# On Windows, use the full install path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Frontend (build-time) ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
