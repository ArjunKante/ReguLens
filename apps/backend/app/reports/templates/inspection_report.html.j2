<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>LM-SCAN Inspection Report — {{ ctx.inspection.inspection_number }}</title>
<style>
  body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #1a1a1a; margin: 24px; }
  h1 { font-size: 18px; margin-bottom: 2px; }
  h2 { font-size: 14px; margin-top: 22px; border-bottom: 1px solid #999; padding-bottom: 3px; }
  .subtitle { color: #555; margin-top: 0; }
  .disclaimer { background: #fff3cd; border: 1px solid #d4a72c; padding: 10px; margin: 12px 0 18px 0; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 8px 0 16px 0; }
  th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: left; vertical-align: top; }
  th { background: #f0f0f0; }
  .status-PASS { color: #1a7f37; font-weight: bold; }
  .status-POTENTIAL_NON_COMPLIANCE { color: #b42318; font-weight: bold; }
  .status-NEEDS_MANUAL_REVIEW { color: #b45309; font-weight: bold; }
  .status-NOT_APPLICABLE { color: #555; }
  .status-UNABLE_TO_VERIFY { color: #555; font-style: italic; }
  .meta-table td:first-child { font-weight: bold; width: 180px; background: #fafafa; }
  .evidence-item { margin: 3px 0; padding-left: 8px; border-left: 2px solid #ccc; }
  .footer { margin-top: 30px; font-size: 9px; color: #777; border-top: 1px solid #ccc; padding-top: 8px; }
  .rule-source { font-size: 9px; color: #555; }
  .demo-banner { background: #7c3aed; color: #fff; font-weight: bold; padding: 10px; margin-bottom: 12px; text-align: center; }
</style>
</head>
<body>

<h1>LM-SCAN Inspection Report{% if ctx.inspection.is_demo %} — DEMO{% endif %}</h1>
<p class="subtitle">AI-Assisted Online Legal Metrology Compliance Inspection System</p>

{% if ctx.inspection.is_demo %}
<div class="demo-banner">
  DEMO INSPECTION — sourced from a bundled, reproducible fixture (a real listing capture) instead of a live
  fetch. This is NOT a finding about a real, currently-live listing and must never be treated as one.
</div>
{% endif %}

<div class="disclaimer">{{ ctx.disclaimer }}</div>

<h2>Inspection Details</h2>
<table class="meta-table">
  <tr><td>Inspection ID</td><td>{{ ctx.inspection.inspection_number }}</td></tr>
  <tr><td>Officer</td><td>{{ ctx.inspection.officer.full_name if ctx.inspection.officer else "—" }}</td></tr>
  <tr><td>Date/Time (generated)</td><td>{{ ctx.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}</td></tr>
  <tr><td>Platform</td><td>{{ ctx.inspection.platform or "—" }}</td></tr>
  <tr><td>Product URL</td><td>{{ ctx.inspection.source_url or "Not applicable — manual inspection from uploaded/captured photos, no listing URL" }}</td></tr>
  <tr><td>Product Title</td><td>{{ ctx.inspection.product.title if ctx.inspection.product else "—" }}</td></tr>
  <tr><td>Overall Status</td><td class="status-{{ ctx.inspection.overall_status }}">{{ ctx.inspection.overall_status or "—" }}</td></tr>
  <tr><td>Generated By</td><td>{{ ctx.generated_by_name }}</td></tr>
</table>

<h2>Extracted Declarations</h2>
<table>
  <tr><th>Field</th><th>Value</th><th>Source</th><th>Confidence</th></tr>
  {% for d in ctx.inspection.declarations %}
  <tr>
    <td>{{ d.field_name }}</td>
    <td>{{ d.value }}</td>
    <td>{{ d.source_type }}</td>
    <td>{{ "%.0f"|format(d.confidence * 100) }}%</td>
  </tr>
  {% else %}
  <tr><td colspan="4">No declarations were extracted for this inspection.</td></tr>
  {% endfor %}
</table>

{% for status, checks in ctx.status_groups.items() %}
<h2>{{ status.replace("_", " ") }} ({{ checks|length }})</h2>
{% if checks %}
<table>
  <tr><th>Rule</th><th>Reason</th><th>Confidence</th><th>Evidence</th><th>Reviewer Decision</th></tr>
  {% for check in checks %}
  <tr>
    <td>
      <strong>{{ check.rule_version.title }}</strong><br>
      <span class="rule-source">{{ check.rule_version.rule.rule_key }} — {{ check.rule_version.rule_reference }}<br>
      Source: {{ check.rule_version.source_document }} ({{ check.rule_version.source_locator }})<br>
      Rule version: v{{ check.rule_version.version_number }}</span>
    </td>
    <td>{{ check.reason }}</td>
    <td>{{ "%.0f"|format(check.confidence * 100) }}%</td>
    <td>
      {% for ev in check.evidence_items %}
      <div class="evidence-item">[{{ ev.evidence_type }}] {{ ev.description }}</div>
      {% else %}
      —
      {% endfor %}
    </td>
    <td>
      {% for rd in check.review_decisions %}
      <div class="evidence-item">{{ rd.decision }} → {{ rd.final_status }} by {{ rd.reviewer.full_name if rd.reviewer else "—" }}{% if rd.comment %}: {{ rd.comment }}{% endif %}</div>
      {% else %}
      PENDING
      {% endfor %}
    </td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>None.</p>
{% endif %}
{% endfor %}

<h2>Rule Versions Evaluated</h2>
<table>
  <tr><th>Rule Key</th><th>Version</th><th>Reference</th><th>Source Document</th><th>Locator</th></tr>
  {% for rv in ctx.rule_version_snapshot %}
  <tr>
    <td>{{ rv.rule_key }}</td>
    <td>v{{ rv.version_number }}</td>
    <td>{{ rv.rule_reference }}</td>
    <td>{{ rv.source_document }}</td>
    <td>{{ rv.source_locator }}</td>
  </tr>
  {% endfor %}
</table>

<div class="footer">
  Generated by LM-SCAN v1.0.0 on {{ ctx.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}.
  {{ ctx.disclaimer }}
</div>

</body>
</html>
